#!/bin/sh
# /etc/config/qwdtt is gone: a tunnel is a netifd interface now, so every
# section it holds becomes one, and the file is set aside rather than deleted
# so its old values can still be read.
#
# The client's own policy routing has no direct counterpart and is rebuilt out
# of standard sections: route_table becomes the interface's ip4table,
# rule_priority and fwmark become the `config rule` that looks that table up.
# Anything that does not map is logged by name rather than dropped quietly.
#
# The install that predates the packages kept only `enabled` and the path of a
# JSON config here. Its settings are read from that file, which stays as
# config_file so the password is not copied into uci.

OLD=${QWDTT_CONFIG:-/etc/config/qwdtt}

[ -f "$OLD" ] || exit 0

say() { logger -t qwdtt "$*"; }

# An option of the archive's JSON, under the name the package schema gives it.
jget() {
	local v

	case "$1" in
	enabled) uci -q get "qwdtt.$sec.enabled" ;;
	peer_host) json_get_var v peer; echo "${v%:*}" ;;
	peer_port) json_get_var v peer; [ "${v##*:}" = "$v" ] || echo "${v##*:}" ;;
	hash) json_select hashes && { json_get_values v; json_select ..; echo "$v"; } ;;
	no_dtls|turn_tcp) json_get_var v "$1"; [ "$v" != 1 ] || echo 1 ;;
	password) ;;
	*) json_get_var v "$1"; echo "$v" ;;
	esac
}

get() {
	if [ -n "$json" ]; then
		jget "$2"
	else
		uci -q get "qwdtt.$1.$2"
	fi
}

copy() {
	local value

	value=$(get "$1" "$2")
	[ -z "$value" ] || uci -q set "network.$name.$3=$value"
}

migrated=0
pending=

for sec in $(uci -q show qwdtt | sed -n "s/^qwdtt\.\([^.=]*\)=qwdtt$/\1/p"); do
	name=$sec
	json=$(uci -q get "qwdtt.$sec.config")
	if [ -n "$json" ]; then
		command -v json_load_file >/dev/null || . /usr/share/libubox/jshn.sh
		json_init
		json_load_file "$json" 2>/dev/null
		# json_load_file returns 0 for a missing or broken file; only the values tell.
		json_get_var peer peer
		[ -n "$peer" ] || {
			say "qwdtt.$sec: $json cannot be read or names no peer, so it was not converted"
			pending=1
			continue
		}
		# The section was always `main`; the device it ran as is the name a
		# tunnel has now.
		json_get_var name tun_name
		name=${name:-qwdtt0}
	fi

	if [ -n "$(uci -q get "network.$name")" ]; then
		say "qwdtt.$sec: network.$name exists already, leaving both alone"
		continue
	fi

	table=$(get "$sec" route_table)
	table=${table:-51820}
	priority=$(get "$sec" rule_priority)
	priority=${priority:-10000}
	# netifd gives an interface that has an ip4table a source rule of its own
	# at 10000, which is also what the old configuration defaulted to. Two
	# rules at one priority are ordered by whichever the kernel was handed
	# first and by nothing written down, so the converted one steps aside.
	[ "$priority" != 10000 ] || priority=9999
	mark=$(get "$sec" fwmark)
	lan=$(get "$sec" lan_interface)
	mode=$(get "$sec" mode)

	uci -q set "network.$name=interface"
	uci -q set "network.$name.proto=qwdtt"
	uci -q set "network.$name.ip4table=$table"
	enabled=$(get "$sec" enabled)
	[ "$enabled" = 1 ] || uci -q set "network.$name.disabled=1"
	[ -z "$json" ] || uci -q set "network.$name.config_file=$json"

	copy "$sec" peer_host    peer_host
	copy "$sec" peer_port    peer_port
	copy "$sec" password     password
	copy "$sec" device_id    device_id
	# device_id has no default any more, and the server knows a device by it
	# and nothing else. A section that left it out was reaching the server as
	# the retired client's constant, so that constant is written out rather
	# than left for the handler to refuse or for a new value to replace.
	[ -n "$(get "$sec" device_id)" ] || uci -q set "network.$name.device_id=openwrt"
	copy "$sec" workers      workers
	copy "$sec" dns          go_dns
	copy "$sec" obfs         obfs
	copy "$sec" captcha_mode captcha_mode
	copy "$sec" vk_auth      vk_auth
	copy "$sec" vk_anon_path vk_anon_path
	copy "$sec" no_dtls      no_dtls
	copy "$sec" turn_tcp     turn_tcp

	for hash in $(get "$sec" hash); do
		uci -q add_list "network.$name.hash=$hash"
	done

	# The rule the client used to add for itself. `in` names a logical
	# interface where lan_interface named a device, and lan is the interface
	# br-lan belongs to in a stock configuration; a router that arranged its
	# LAN differently has to correct this, which is why the old value is
	# logged rather than guessed at.
	# Only for a tunnel that runs: a disabled one will not route, so it gets no
	# rule pointing the LAN at a table it never fills.
	if [ "$enabled" != 1 ]; then
		say "qwdtt.$sec is disabled: network.$name carries no rule, tick 'Route LAN client traffic through this tunnel' on the qWDTT tab when you enable it"
	else

	uci -q set "network.${name}_rule=rule"
	uci -q set "network.${name}_rule.lookup=$table"
	uci -q set "network.${name}_rule.priority=$priority"
	if [ -n "$mark" ]; then
		uci -q set "network.${name}_rule.mark=$mark"
	else
		uci -q set "network.${name}_rule.in=lan"
	fi

	fi

	say "qwdtt.$sec is now network.$name: route_table $table is its ip4table, rule_priority $priority is network.${name}_rule"
	[ -z "$lan" ] || [ "$lan" = br-lan ] ||
		say "qwdtt.$sec: lan_interface was $lan, and network.${name}_rule selects the lan interface instead; correct it if those are not the same network"
	[ -z "$mode" ] || [ "$mode" = rawtun ] ||
		say "qwdtt.$sec: mode $mode is not carried over, this build only ever ran rawtun"

	migrated=$((migrated + 1))
done

uci commit network
# uci-defaults keeps a script that fails, so an unreadable JSON config is tried again at the next boot.
if [ -z "$pending" ]; then
	mv "$OLD" "$OLD.migrated"
	say "$OLD has been converted into $migrated interface(s) and set aside as $OLD.migrated"
else
	say "$OLD is kept: a JSON config could not be read, and the conversion runs again at the next boot"
fi

[ "$migrated" = 0 ] || [ ! -x /etc/init.d/network ] || /etc/init.d/network reload
[ -z "$pending" ]
