#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Action half of the LuCI page at Services -> qWDTT. See qwdtt-luci for why
# this is a separate script: rpcd grants exec on a path, not on a verb, so
# keeping the state-changing verbs here lets the ACL put them under "write"
# while status and logs stay readable under "read".
#
# The verb list is enforced here, not in the ACL. Passing arbitrary arguments
# through to qwdtt would hand the browser every subcommand it has.
#
# Note start/stop are not just runtime: qwdtt writes qwdtt.main.enabled, so
# they change whether the tunnel comes back after a reboot. The page says so on
# the buttons.

set -eu

CTL=/usr/bin/qwdtt

# /usr/bin/qwdtt comes from the sibling 'qwdtt' package, which this one
# depends on. Checked anyway because a dependency can be force-removed, and
# said plainly rather than failing with a bare "not found", because the page
# surfaces this text to the operator.
require_ctl() {
	[ -x "$CTL" ] || {
		echo "$CTL is missing. It comes from the 'qwdtt' package, which" >&2
		echo "luci-app-qwdtt depends on: reinstall it, then retry." >&2
		exit 3
	}
}

case "${1:-}" in
start|stop|restart)
	require_ctl
	exec "$CTL" "$1" ;;
*)
	echo "usage: qwdtt-luci-act start|stop|restart" >&2
	exit 2 ;;
esac
