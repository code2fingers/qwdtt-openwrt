#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Backend for the LuCI page at Services -> qWDTT.
#
# The rpcd ACL grants exec on this path only, and the verb list below is
# enforced here rather than in the ACL: rpcd whitelists a command, not its
# arguments, so a page that could pass arbitrary arguments to qwdtt would
# effectively hold every subcommand it has. Everything reachable from the
# browser is therefore exactly what this case statement allows.
#
# This half is read-only and is granted under the ACL's "read" scope. Anything
# that changes state lives in qwdtt-luci-act, granted under "write", because
# rpcd whitelists a path rather than a verb -- one script for both would let a
# read-only LuCI account stop the tunnel.
#
# Every reading verb delegates to qwdtt rather than reimplementing it. An
# earlier revision computed the status fields here so the page would still work
# with the tool absent, and the two copies promptly drifted -- different
# placeholders for an unset enabled flag, and fields present in one and not the
# other. There is one implementation now, in the package that owns the tunnel.
#
# The split that does matter is cost, not location: 'brief' reads files and UCI,
# which is safe to poll, while 'tunnel' pings with a timeout per probe host.
# Several open browser tabs polling the latter would be a steady stream of
# probes, so the page asks for it only when the operator presses the button.

set -eu

CTL=/usr/bin/qwdtt
CLIENT=/usr/bin/qwdtt-client

# /usr/bin/qwdtt comes from the sibling 'qwdtt' package, which this one
# depends on, so it is normally present. Checked anyway, because a dependency
# can be force-removed, and said plainly rather than failing with a bare
# "not found", because the page surfaces this text to the operator.
require_ctl() {
	[ -x "$CTL" ] || {
		echo "$CTL is missing. It comes from the 'qwdtt' package, which" >&2
		echo "luci-app-qwdtt depends on: reinstall it, then retry." >&2
		exit 3
	}
}

case "${1:-}" in
status)  require_ctl; exec "$CTL" brief ;;
tunnel)  require_ctl; exec "$CTL" tunnel ;;
# Asks VK whether each configured hash still resolves to a TURN allocation.
# Network-bound and slow -- seconds per hash -- so it is on demand only, never
# polled. The client exits after the checks; -check-hashes returns before
# -peer or -password are required, so neither is passed.
check-hashes)
	[ -x "$CLIENT" ] || {
		echo "$CLIENT is missing. luci-app-qwdtt does not ship the client:" >&2
		echo "install or deploy qWDTT, then retry." >&2
		exit 3
	}
	# UCI list values arrive space-separated; the client wants one comma
	# separated -vk value and reduces links to hashes itself.
	hashes=$(uci -q get qwdtt.main.hash | tr -s ' ' ',' | sed -e 's/^,//' -e 's/,$//')
	[ -n "$hashes" ] || { echo "no hashes are configured" >&2; exit 4; }
	# The auth mode changes how a hash is resolved, so pass what is configured
	# rather than letting the client fall back to its own defaults.
	exec "$CLIENT" -check-hashes -vk "$hashes" \
		-vk-auth "$(uci -q get qwdtt.main.vk_auth || echo anonymous)" \
		-vk-anon-path "$(uci -q get qwdtt.main.vk_anon_path || echo vkcalls)" \
		-captcha-mode "$(uci -q get qwdtt.main.captcha_mode || echo auto)" 2>&1 ;;
# Folded in from a separate qwdtt-log-tail script, which existed to be a fixed
# argument list for the ACL to whitelist -- but the ACL only ever named this
# script, which exec'd it, so it bought nothing and hardcoded the log path a
# second time. The line count is the fixed argument list.
log)     require_ctl; exec "$CTL" log 400 ;;
*)
	echo "usage: qwdtt-luci status|tunnel|log|check-hashes" >&2
	exit 2 ;;
esac
