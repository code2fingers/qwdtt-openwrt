# Named for the package rather than for the view it serves. luci.mk compiles
# each po into <basename>.<lang>.lmo and the runtime merges every file in
# /usr/lib/lua/luci/i18n into one catalogue, so the name matters only as a path
# on disk -- and a plain status.ru.lmo is a path any other package with a
# status page also claims. apk then refuses to install this one, which is how
# luci-i18n-amneziawg-ru came to own the Russian status strings on a router
# that had both.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Project-Id-Version: luci-proto-qwdtt\n"
"Language: ru\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

msgid "qWDTT"
msgstr "qWDTT"

