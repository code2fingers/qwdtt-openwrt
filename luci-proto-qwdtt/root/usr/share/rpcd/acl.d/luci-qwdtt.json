{
	"luci-proto-qwdtt": {
		"description": "Grant access to the qWDTT status page",
		"read": {
			"cgi-io": [ "exec" ],
			"ubus": {
				"luci.qwdtt": [ "getRuntime" ],
				"file": [ "exec" ]
			},
			"file": {
				"/bin/ping": [ "exec" ],
				"/usr/bin/ping": [ "exec" ]
			},
			"uci": [ "network" ]
		},
		"write": {
			"uci": [ "network", "firewall" ]
		}
	}
}
