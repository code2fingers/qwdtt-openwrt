#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Control script for the qWDTT RAW-IP tunnel. Driven by the LuCI page at
# Services -> qWDTT and useful directly over ssh. A package of its own rather
# than part of luci-app-qwdtt: a headless router needs it with no web
# interface installed.
#
# The tunnel is a daemon-owned TUN device, not a netifd interface, so the
# service is what you start and stop. Adding a netifd interface made netifd
# flush the daemon's address and route.
#
# Client output goes to the system log; read it with 'logread -e qwdtt'.

# Assumed, not provided: /etc/init.d/qwdtt, which start and stop delegate to;
# qwdtt.main.enabled, which the init script reads to decide whether to start at
# boot; and table 51820, which the client creates and this only reports.
RT_TABLE=51820
# From UCI rather than hardcoded, because the LuCI page reads the same option:
# hardcoded, setting tun_name made the page report the interface up while this
# reported it absent.
TUN=$(uci -q get qwdtt.main.tun_name || :)
[ -n "$TUN" ] || TUN=qwdtt0
PROBE_HOSTS='8.8.8.8 1.1.1.1'
PROBE_COUNT=10                  # probes per host; loss matters, not reachability
PROBE_DEADLINE=4                # seconds; caps the probe against a dead host
MAX_LOSS=40                     # percent; above this the tunnel cannot carry TCP

# virt-shell runs its shell inside 'nsclient', where the tunnel interface does
# not exist, so the check below would call a healthy tunnel down.
in_other_netns() {
	[ -r /proc/1/ns/net ] || return 1
	[ "$(readlink /proc/self/ns/net 2>/dev/null)" != "$(readlink /proc/1/ns/net 2>/dev/null)" ]
}

# Loss rather than one packet: with only some workers stale the tunnel still
# answers intermittently, and a single ping calls that healthy. The awk reads
# the loss percentage, not the received count, whose field ends in a comma and
# parsed as 0. -I takes the DEVICE; with an address the packet still leaves by
# the default route and never enters the tunnel. -A because BusyBox ping has
# whole-second intervals only.
tunnel_ok() {
	for h in $PROBE_HOSTS; do
		loss=$(ping -c"$PROBE_COUNT" -A -w"$PROBE_DEADLINE" -I "$TUN" "$h" 2>/dev/null |
			awk '{ for (i = 1; i <= NF; i++) if ($i ~ /%$/) { sub(/%$/, "", $i); print $i; exit } }')
		loss=${loss%%.*}
		[ -n "$loss" ] || loss=100
		TUNNEL_RESULT="${loss}% loss via $h"
		[ "$loss" -le "$MAX_LOSS" ] && return 0
	done
	return 1
}

# Everything readable without sending a packet, so the LuCI page can poll it
# through `qwdtt brief`. One implementation on purpose: this was once copied
# into the page's rpcd helper and the two drifted.
report_static() {
	echo "enabled:   $(uci -q get qwdtt.main.enabled || echo '?')"
	if ip link show "$TUN" >/dev/null 2>&1; then
		# Not `ip -br addr`: its second column is the operational state,
		# which a userspace TUN reports as "unknown" however well it is
		# working. carrier is the field that means something here.
		case "$(cat "/sys/class/net/$TUN/carrier" 2>/dev/null)" in
		1) echo "interface: $TUN up, carrier ok" ;;
		0) echo "interface: $TUN present but NO CARRIER" ;;
		*) echo "interface: $TUN present, carrier not reported" ;;
		esac
		echo "address:   $(ip -4 -o addr show "$TUN" 2>/dev/null | awk '{printf "%s ", $4}')"
		echo "route:     $(ip route show table "$RT_TABLE" 2>/dev/null | head -1)"
	elif in_other_netns; then
		echo "interface: not visible from this network namespace"
		echo "           ($TUN lives in the root namespace; the tunnel may be fine)"
	else
		echo "interface: down ($TUN absent)"
	fi
	if pgrep -f qwdtt-client >/dev/null 2>&1; then
		running=yes
	else
		running=no
	fi
	echo "running:   $running"
	ph=$(uci -q get qwdtt.main.peer_host || :)
	pp=$(uci -q get qwdtt.main.peer_port || :)
	echo "peer:      ${ph}${pp:+:$pp}"
	echo "hashes:    $(uci -q get qwdtt.main.hash | wc -w) configured"
	# The last [STATS] line outlives the process, so a stopped tunnel would
	# otherwise still show the traffic it carried before it stopped.
	if [ "$running" = yes ]; then
		echo "traffic:   $(logread -e qwdtt 2>/dev/null | grep -a 'STATS' | tail -1 | sed 's/.*\[STATS\] //')"
	else
		echo "traffic:   -"
	fi
	echo "log:       logread -e qwdtt"
}

# The end-to-end probe alone, so the page's button can show its result instead
# of repeating the whole status underneath the copy it already polls.
report_tunnel() {
	if tunnel_ok; then
		echo "tunnel:    ok ($TUNNEL_RESULT)"
	else
		echo "tunnel:    DEAD ($TUNNEL_RESULT)"
	fi
}

case "${1:-status}" in
start)
	uci -q set qwdtt.main.enabled='1'; uci -q commit qwdtt
	# start, not restart: procd's restart stops first, and stopping an
	# unregistered service prints a ubus error the page shows as a failure.
	/etc/init.d/qwdtt start && echo "qwdtt: started (enabled at boot)"
	;;
stop)
	uci -q set qwdtt.main.enabled='0'; uci -q commit qwdtt
	/etc/init.d/qwdtt stop && echo "qwdtt: stopped (disabled at boot)"
	;;
restart)
	/etc/init.d/qwdtt restart && echo "qwdtt: restarted"
	;;
status)
	report_static
	report_tunnel
	echo "--- recent log ---"
	logread -e qwdtt 2>/dev/null | grep -aviE 'STATS|DEBUG' | tail -8
	;;
brief)
	report_static ;;
tunnel)
	report_tunnel ;;
log)
	logread -e qwdtt 2>/dev/null | tail -n "${2:-50}"
	;;
*)
	echo "usage: qwdtt start | stop | restart | status | brief | tunnel | log [n]" >&2
	exit 1
	;;
esac
